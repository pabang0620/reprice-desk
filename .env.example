# Leave the keys empty to run on the built-in stand-ins for PayPal and Claude.
PORT=3002
FORCE_MOCK=0

# Claude (server side only; the browser never sees it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Local development only: account = use the local Claude Code login (no API key is used). Empty = key or stand-in.
LLM_BACKEND=

# PayPal sandbox app (REST credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# AG Studio trial licence (client side). Studio runs without a key locally but shows a watermark.
VITE_AG_STUDIO_LICENSE_KEY=

# Bundle pool
BUNDLES_FILE=
BUNDLE_MAX_AGE_DAYS=2
MOCK_BUNDLE_COUNT=16
BUNDLE_STORE_MAX=200
MAX_SESSIONS=500

# Studio model proxy limits (calls per session, calls per day for the whole server)
LLM_CALLS_PER_SESSION=150
LLM_CALLS_PER_DAY=2000

# Sandbox findings from VERIFY.md (true, false, or empty when not verified yet)
V9_KEPT_RECEIVE_PLAN_EMAIL=
V4_PATCH_SENDS_EMAIL=
INCREASE_CAP_PCT=
INCREASE_CAP_DAYS=180

SCHEDULER_INTERVAL_MS=3600000
